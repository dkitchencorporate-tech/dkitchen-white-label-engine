# Copia este archivo como .env.local y rellena los valores. NUNCA subas valores reales al repo.

# --- Base de datos ---
# Conexión de la API: rol de login miembro de motor_app (sin BYPASSRLS, no dueño de las tablas).
APP_DATABASE_URL=
# Conexión del dueño de la base, solo para migraciones, semillas y crear-admin (nunca en la API).
MIGRATIONS_DATABASE_URL=

# --- Autenticación ---
# Mínimo 32 caracteres aleatorios (p. ej. `openssl rand -hex 32`).
APP_JWT_SECRET=

# --- URL pública (enlaces en los correos) ---
APP_URL=

# --- Correo saliente (opcional) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Notificaciones push (opcional) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_JWK=
VAPID_SUBJECT=

# --- Imágenes de producto en Vercel Blob (opcional) ---
BLOB_READ_WRITE_TOKEN=
